{
  "family": "shopsmart-task-def",
  "executionRoleArn": "arn:aws:iam::098337978107:role/LabRole",
  "taskRoleArn": "arn:aws:iam::098337978107:role/LabRole",
  "networkMode": "awsvpc",
  "containerDefinitions": [
    {
      "name": "shopsmart-server",
      "image": "098337978107.dkr.ecr.us-east-1.amazonaws.com/shopsmart-server:latest",
      "cpu": 256,
      "memory": 512,
      "portMappings": [
        {
          "containerPort": 5001,
          "hostPort": 5001,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/shopsmart-task-def",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      }
    },
    {
      "name": "shopsmart-client",
      "image": "098337978107.dkr.ecr.us-east-1.amazonaws.com/shopsmart-client:latest",
      "cpu": 256,
      "memory": 512,
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 80,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/shopsmart-task-def",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      }
    }
  ],
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024"
}
